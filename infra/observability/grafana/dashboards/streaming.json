{
  "uid": "ptp-streaming",
  "title": "PTP \u2014 Streaming",
  "description": "Status processor and bronze writer: throughput, lag, rejects, failures (spec 04 \u00a7Metrics, SC-0007).",
  "tags": [
    "ptp"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Processor up",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "max(up{job=\"ptp-processor\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Longest active trigger (s) \u2014 hung batch if large",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "max(ptp_trigger_active_seconds)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Offsets behind latest",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "max(ptp_offsets_behind_latest{query=\"status-processor\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Input rate by query (records/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "sum by (query) (rate(ptp_input_rows_total[1m]))",
          "legendFormat": "{{query}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Applied / duplicate / rejected (events/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "sum(rate(ptp_events_applied_total[1m]))",
          "legendFormat": "applied"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "sum(rate(ptp_events_duplicate_total[1m]))",
          "legendFormat": "duplicate"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "sum(rate(ptp_events_rejected_total[1m]))",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Micro-batch duration p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ptp_batch_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ptp_batch_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Offsets behind latest by query",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "ptp_offsets_behind_latest",
          "legendFormat": "{{query}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Rejected records by error code (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "sum by (error_code) (increase(ptp_events_rejected_total[$__range]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Sink failures by stage (last 24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "sum by (sink) (increase(ptp_sink_failures_total[24h]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Seconds since last micro-batch (no progress while idle)",
      "datasource": {
        "type": "prometheus",
        "uid": "ptp-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ptp-prometheus"
          },
          "expr": "time() - ptp_last_progress_timestamp_seconds",
          "legendFormat": "{{query}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
