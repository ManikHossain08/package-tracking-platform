{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/dlq-record.v1.schema.json",
  "title": "Dead-letter record v1",
  "description": "Records on topic package-events.dlq.v1. At-least-once: dedupe on source.(topic, partition, offset).",
  "type": "object",
  "additionalProperties": false,
  "required": ["dlq_schema_version", "error_code", "errors", "raw_value", "raw_value_encoding", "source", "processor", "rejected_at"],
  "properties": {
    "dlq_schema_version": { "const": "1.0" },
    "error_code": { "$ref": "#/$defs/errorCode" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "field", "message"],
        "properties": {
          "code": { "$ref": "#/$defs/errorCode" },
          "field": { "type": ["string", "null"], "description": "JSON pointer, e.g. /source/device_id" },
          "message": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "raw_value": { "type": ["string", "null"], "description": "Original value; null only for Kafka tombstones" },
    "raw_value_encoding": { "type": "string", "enum": ["utf8", "base64"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "partition", "offset", "kafka_timestamp", "key"],
      "properties": {
        "topic": { "type": "string" },
        "partition": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "kafka_timestamp": { "type": "string", "format": "date-time" },
        "key": { "type": ["string", "null"] }
      }
    },
    "processor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "run_id", "batch_id"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "run_id": { "type": "string" },
        "batch_id": { "type": "integer", "minimum": 0 }
      }
    },
    "rejected_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "errorCode": {
      "type": "string",
      "enum": [
        "INVALID_ENCODING", "PAYLOAD_TOO_LARGE", "INVALID_JSON", "NOT_JSON_OBJECT",
        "UNSUPPORTED_SCHEMA_VERSION", "MISSING_REQUIRED_FIELD", "INVALID_FIELD_TYPE",
        "UNKNOWN_EVENT_TYPE", "INVALID_FORMAT", "INVALID_TIMESTAMP", "TIMESTAMP_MISSING_OFFSET",
        "MISSING_CONDITIONAL_FIELD", "EVENT_TIME_IN_FUTURE", "EVENT_TIME_TOO_OLD"
      ]
    }
  }
}
