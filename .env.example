# Copy to .env (git-ignored) with `make env`, which also generates a random password.
# Never commit .env. Every variable used by the stack is listed here (NFR-06).

# --- PostgreSQL (infra/docker-compose.yml) ---
POSTGRES_DB=ptp
POSTGRES_ADMIN_USER=ptp_admin
# Secret: set a real value in .env only. `make env` generates one.
POSTGRES_ADMIN_PASSWORD=__set_in_dot_env__
# Host port; 55432 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_HOST_PORT=55432
# Application roles (spec 06). Secrets: `make env` generates each one.
PTP_MIGRATOR_PASSWORD=__set_in_dot_env__
PTP_STREAM_WRITER_PASSWORD=__set_in_dot_env__
PTP_READER_PASSWORD=__set_in_dot_env__
PTP_BATCH_WRITER_PASSWORD=__set_in_dot_env__
PTP_AIRFLOW_PASSWORD=__set_in_dot_env__

# --- Airflow (profile orchestration; UI on http://127.0.0.1:8080, user admin) ---
AIRFLOW_ADMIN_PASSWORD=__set_in_dot_env__
# --- Observability (profile obs; Grafana http://127.0.0.1:3000, user admin) ---
GRAFANA_ADMIN_PASSWORD=__set_in_dot_env__
# Batch jobs on the host push here (containers use http://pushgateway:9091). Unset = no push.
PUSHGATEWAY_URL=localhost:9091
# `make process` on the host: metrics endpoint port and bind address (loopback by default).
METRICS_PORT=9464
METRICS_BIND_ADDRESS=127.0.0.1
# Retention (NFR-08), applied by the maintenance DAG.
BRONZE_RETENTION_DAYS=90
SILVER_RETENTION_DAYS=400
PROCESSED_EVENTS_RETENTION_DAYS=30

# --- Status processor (run on the host with `make process`; spec 08) ---
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:55432/ptp
CHECKPOINT_ROOT=data/checkpoints
LAKE_ROOT=data/lake
# Absolute host path of ./data; `make env` fills it in. Containers mount ./data at this SAME path, because the bronze
# file sink's _spark_metadata log stores absolute file paths (the lake must have one path in every runtime).
PTP_HOST_DATA_DIR=__absolute_path_of_repo_data__
BRONZE_ENABLED=true
# Silver compaction target (bytes per file, FR-STO-02).
SILVER_TARGET_FILE_BYTES=134217728
TRIGGER_INTERVAL_SECONDS=5
MAX_OFFSETS_PER_TRIGGER=50000
PROCESSING_MODE=live

# --- Kafka ---
# From the host. Containers use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
EVENTS_TOPIC=package-events.v1
DLQ_TOPIC=package-events.dlq.v1
